# Party cancellation request email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Little Wanderers <onboarding@resend.dev>
MARKETING_PHYSICAL_ADDRESS=Little Wanderers, Bishop's Corner, West Hartford, CT
OWNER_EMAIL=owner@littlewanderers.com

# Approximate crowd-level reference capacity for public/staff occupancy UI
OCCUPANCY_CAPACITY=24

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@littlewanderersplay.com

# Square webhook: URL must exactly match the notification URL in Square.
SQUARE_WEBHOOK_URL=https://www.thelittlewanderers.com/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Server-only Square credentials. Development/Preview stay in Sandbox.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-07-15
# SUBSCRIPTION_PLAN_VARIATION ID, not the parent SUBSCRIPTION_PLAN ID.
SQUARE_PLAN_VARIATION_ID=
# ITEM_VARIATION with a fixed USD 300.00 price. Required for Production party checkout.
SQUARE_PARTY_ITEM_VARIATION_ID=
# Enable each flow only after its database migration, mapping and Sandbox checks.
PARTY_PAYMENTS_ENABLED=false
MEMBERSHIP_PAYMENTS_ENABLED=false
ADMISSION_PAYMENTS_ENABLED=false
# Square Application ID for the iPad Square POS handoff; not an access token.
SQUARE_APPLICATION_ID=
CLASS_PAYMENTS_ENABLED=false
# Optional explicit Sandbox email recipient. Unset suppresses Sandbox party emails.
SQUARE_SANDBOX_EMAIL_TO=
# Vercel Cron sends this secret as a Bearer token.
CRON_SECRET=
